# Copy to trekora/src/.env (never commit .env)
# Vite loads from this directory (envDir: src/)

# --- Site URL (public marketing site only — never api.trekora.in) ---
VITE_SITE_ORIGIN=https://www.trekora.in

# --- Feature flags (production: all false) ---
VITE_ENABLE_LOGIN=false
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_EMI=false

# --- Admin UI (disable in production unless required) ---
# Unlock prompts for ADMIN_API_SECRET (server-only). Never set a VITE_ admin secret.
VITE_ADMIN_ENABLED=false

# --- Cloudinary (public in browser) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side only — never prefix with VITE_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Weather (server-side; keeps key out of browser bundle) ---
OPENWEATHER_API_KEY=

# --- Optional client (restrict in provider dashboards) ---
# Dev fallback only — production uses OPENWEATHER_API_KEY + /api/v1/weather
VITE_OPENWEATHER_API_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_MAP_EMBED_SRC=
VITE_GOOGLE_MAP_EMBED_PB=

# --- SMTP (server-side only) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_FROM=
ADMIN_EMAIL=

# --- MongoDB (server-side only) ---
MONGODB_URI=
MONGODB_USE_PUBLIC_DNS=false
DISCOUNT_API_PORT=3001

# Admin API (server-side; use x-admin-secret header)
ADMIN_API_SECRET=

# Optional CORS for discount API (comma-separated origins, production)
# Example: https://www.trekora.in,https://trekora.in
CORS_ORIGINS=

# Railway public URL (optional — only if proxying /api/* to Railway instead of Vercel serverless)
# DISCOUNT_API_URL=https://your-service.up.railway.app
