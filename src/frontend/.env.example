# Copy to `../.env` or `../.env.local` next to this folder (Vite `envDir` is `trekora/src`).
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# --- Site URL (SEO, canonical, JSON-LD, sitemap — use www, NEVER api.trekora.in) ---
VITE_SITE_ORIGIN=https://www.trekora.in

# --- Feature flags (production: all false) ---
VITE_ENABLE_LOGIN=false
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_EMI=false

# --- Admin UI (keep disabled in production unless needed) ---
VITE_ADMIN_ENABLED=false
VITE_ADMIN_SECRET=

# Client (Vite) — required for Cloudinary video/image optimization in production
# (falls back to ddbcauxef if unset; set explicitly on Vercel for clarity)
VITE_CLOUDINARY_CLOUD_NAME=ddbcauxef
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side only — never prefix with VITE_ (Railway / local discount API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_API_SECRET=
MONGODB_URI=
# Windows / local DNS: set true when mongodb+srv SRV lookups fail (querySrv EBADNAME)
MONGODB_USE_PUBLIC_DNS=true
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
CORS_ORIGINS=

# Google Maps — contact page embed (Share → Embed a map on Google Maps)
# Paste full iframe src as VITE_GOOGLE_MAP_EMBED_SRC, or only the pb=… value as VITE_GOOGLE_MAP_EMBED_PB
VITE_GOOGLE_MAP_EMBED_SRC=
VITE_GOOGLE_MAP_EMBED_PB=

# Weather — prefer server-only key (never exposed in the browser bundle)
OPENWEATHER_API_KEY=

# Optional client features (public keys only — never put secrets here)
# Legacy dev fallback only; production should use OPENWEATHER_API_KEY + /api/v1/weather
VITE_OPENWEATHER_API_KEY=
VITE_OPENWEATHERMAP_KEY=
VITE_RAZORPAY_KEY_ID=

