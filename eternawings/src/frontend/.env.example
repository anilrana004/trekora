# Copy to `../.env` or `../.env.local` next to this folder (Vite `envDir` is `eternawings/src`).
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# Client (Vite) — required for Cloudinary fetch CDN + automatic format/quality (never expose secrets with VITE_)
VITE_CLOUDINARY_CLOUD_NAME=
# Optional for direct unsigned uploads from admin UI (recommended for staging; for production prefer signed uploads)
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side only — uploads & signed URLs (CI / future upload API; never prefix with VITE_)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional client features (only names starting with VITE_ are exposed in the browser bundle)
VITE_OPENWEATHER_API_KEY=
# Legacy alias — use VITE_OPENWEATHER_API_KEY if possible
VITE_OPENWEATHERMAP_KEY=
VITE_RAZORPAY_KEY_ID=
