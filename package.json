{
    "name": "@trekora/app",
    "type": "module",
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=7.0.0",
        "npm": "please use pnpm"
    },
    "scripts": {
        "dev": "pnpm -C src/frontend dev",
        "dev:clean": "pnpm -C src/frontend dev:clean",
        "build": "pnpm -r --if-present run build",
        "typecheck": "pnpm -r --if-present run typecheck",
        "check": "pnpm -r --if-present run check",
        "fix": "pnpm -r --if-present run fix",
        "bindgen": "node ./scripts/generate-actor-bindings.mjs",
        "discount-api": "pnpm -C backend start",
        "discount-api:prod": "pnpm -C backend start",
        "ensure-indexes": "node backend/scripts/ensure-indexes.mjs",
        "deploy:preflight": "node scripts/deploy-preflight.mjs",
        "seed": "node scripts/seed-discounts.mjs",
        "seed:reviews": "node scripts/seed-reviews.mjs",
        "seed:all": "node scripts/seed-discounts.mjs && node scripts/seed-reviews.mjs",
        "security:check": "node scripts/check-secrets.mjs",
        "security:bundle": "node scripts/check-bundle-secrets.mjs",
        "security:all": "pnpm security:check && pnpm -C src/frontend security:bundle",
        "publish:dns-aid": "node scripts/publish-dns-aid-cloudflare.mjs"
    },
    "devDependencies": {
        "dotenv": "^16.5.0",
        "sharp": "^0.34.4"
    },
    "dependencies": {
        "@caffeineai/core-infrastructure": "^0.3.0"
    }
}